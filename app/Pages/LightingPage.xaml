<Page x:Class="OpenEVision.Pages.LightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Lighting">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="1000">
            <ui:TextBlock FontTypography="Title" Text="Lighting" Margin="0,0,0,4" />
            <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"
                          Text="The keyboard's built-in effects. Saved to the keyboard's flash memory, so they also run while this app is closed." />

            <ui:InfoBar x:Name="Error" Severity="Error" Title="Operation failed" IsClosable="True" Margin="0,0,0,12" />

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Lightbulb24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Effect" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Lighting mode that runs on the keyboard itself" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ModeBox" MinWidth="240" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="BrightnessHigh24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><ui:TextBlock Text="Brightness" /></ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="BrightnessSlider" Width="240" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" ValueChanged="Changed" />
                    <ui:TextBlock x:Name="BrightnessText" Width="40" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="TopSpeed24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><ui:TextBlock Text="Speed" /></ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="Slow" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="SpeedSlider" Width="200" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight" ValueChanged="Changed" />
                    <ui:TextBlock Text="Fast" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowRight24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Direction" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Used by moving effects; what each value does depends on the mode" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="DirectionBox" MinWidth="160" SelectionChanged="Changed">
                    <ComboBoxItem Content="Direction 1" />
                    <ComboBoxItem Content="Direction 2" />
                    <ComboBoxItem Content="Direction 3" />
                    <ComboBoxItem Content="Direction 4" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,4" IsExpanded="True">
                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Color24" /></ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Text="Color" />
                            <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Used by single-color modes" />
                        </StackPanel>
                        <Border x:Name="ColorSwatch" Grid.Column="1" Width="32" Height="20" CornerRadius="4" Margin="0,0,16,0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <WrapPanel x:Name="Palette" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="HexBox" Width="120" PlaceholderText="#RRGGBB" LostFocus="Hex_LostFocus" KeyDown="Hex_KeyDown" />
                        <ui:ToggleSwitch x:Name="RandomSwitch" Content="Random color" Margin="24,0,0,0" Checked="Changed" Unchecked="Changed" />
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <ui:TextBlock x:Name="SavedText" FontTypography="Caption" Margin="4,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>

<Page x:Class="OpenEVision.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="1000">
            <ui:TextBlock FontTypography="Title" Text="Settings" Margin="0,0,0,20" />

            <ui:TextBlock FontTypography="BodyStrong" Text="Startup" Margin="0,0,0,8" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Power24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Start with Windows" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Starts in the tray, without a window, when you sign in" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="AutostartSwitch" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Play24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Resume last effect" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="The software effect that was running when the app closed starts again" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ResumeSwitch" Checked="Resume_Changed" Unchecked="Resume_Changed" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowMinimize24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Close to tray" />
                        <ui:TextBlock FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Effects keep running when the window is closed" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TraySwitch" Checked="Tray_Changed" Unchecked="Tray_Changed" />
            </ui:CardControl>

            <ui:TextBlock FontTypography="BodyStrong" Text="Appearance" Margin="0,24,0,8" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="DarkTheme24" /></ui:CardControl.Icon>
                <ui:CardControl.Header><ui:TextBlock Text="Theme" /></ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" MinWidth="160" SelectionChanged="Theme_Changed">
                    <ComboBoxItem Content="System" Tag="system" />
                    <ComboBoxItem Content="Light" Tag="light" />
                    <ComboBoxItem Content="Dark" Tag="dark" />
                </ComboBox>
            </ui:CardControl>

            <ui:TextBlock FontTypography="BodyStrong" Text="About" Margin="0,24,0,8" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Info24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="AboutTitle" Text="OpenEVision" />
                        <ui:TextBlock x:Name="AboutText" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>

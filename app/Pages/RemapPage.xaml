<Page x:Class="OpenEVision.Pages.RemapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:OpenEVision.Controls"
      Title="Key remapping">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32" MaxWidth="1100">
            <ui:TextBlock FontTypography="Title" Text="Key remapping" Margin="0,0,0,4" />
            <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap"
                          Text="Pick a key and choose what it does. Assignments are saved to the keyboard's flash and work on any computer. Remapped keys have a gold outline; Fn cannot be changed." />

            <ui:InfoBar x:Name="Error" Severity="Error" Title="Operation failed" IsClosable="True" Margin="0,0,0,12" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <controls:KeyboardPreview x:Name="Board" Interactive="True" />
            </Border>

            <ui:CardControl Margin="0,12,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowSwap24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="SelTitle" Text="No key selected" />
                        <ui:TextBlock x:Name="SelDetail" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Click a key above" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ActionBox" MinWidth="260" IsEnabled="False" DisplayMemberPath="Label" SelectedValuePath="Id" />
                    <ui:Button x:Name="ApplyButton" Content="Apply" Appearance="Primary" Margin="8,0,0,0" IsEnabled="False" Click="Apply_Click" />
                    <ui:Button x:Name="DefaultButton" Content="Default" Margin="8,0,0,0" IsEnabled="False" Click="Default_Click" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowReset24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Factory key layout" />
                        <ui:TextBlock x:Name="ResetDetail" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Restore every key to its original assignment" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Reset" Click="Reset_Click" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
